# Docker Compose deployment overrides.
# Copy to .env when you need environment-specific images, ports, model paths, or GPU counts.

MILVUS_IMAGE=milvusdb/milvus:v2.4.17
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
OLLAMA_IMAGE=ollama/ollama:0.9.0

LOCAL_MODELS_DIR=./local-models
RAG_APP_ENV_FILE=./config/app.env
HOST_GATEWAY_NAME=host.docker.internal
HOST_GATEWAY_IP=host-gateway

APP_HOST=0.0.0.0
APP_PORT=8080
APP_HOST_PORT=8080
WAIT_FOR_MILVUS=true
MILVUS_CONNECT_TIMEOUT_SEC=180
MILVUS_CONNECT_RETRY_INTERVAL_SEC=2

EMBEDDING_MODEL_NAME=/models/BAAI/bge-m3
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_BATCH_SIZE=32
EMBEDDING_SERVICE_PORT=8000
EMBEDDING_HOST_PORT=8001
EMBEDDING_GPU_COUNT=1

RERANK_MODEL_NAME=/models/BAAI/bge-reranker-base
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=16
RERANK_DEFAULT_TOP_N=10
RERANK_SERVICE_PORT=8000
RERANK_HOST_PORT=8002
RERANK_GPU_COUNT=1

OLLAMA_HOST_PORT=11434
OLLAMA_GPU_COUNT=1

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
