# RAG System Configuration
#
# 环境配置
#
# ==================== 应用配置 ====================
APP_NAME=RAG-System
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=true
LOG_LEVEL=INFO
#
# ==================== Milvus 配置 ====================
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_USER=minioadmin
MILVUS_PASSWORD=minioadmin
MILVUS_SECURE=false
MILVUS_COLLECTION=rag_documents
MILVUS_EMBEDDING_DIM=1024
MILVUS_ENABLE_SPARSE=true
MILVUS_ENABLE_HYBRID_SEARCH=true
MILVUS_HYBRID_RANKER=weighted
MILVUS_HYBRID_DENSE_WEIGHT=0.65
MILVUS_HYBRID_SPARSE_WEIGHT=0.35
MILVUS_RECREATE_FOR_SPARSE=false
WAIT_FOR_MILVUS=true
MILVUS_CONNECT_TIMEOUT_SEC=180
MILVUS_CONNECT_RETRY_INTERVAL_SEC=2
#
# ==================== 服务配置 ====================
EMBEDDING_SERVICE_URL=http://embedding-service:8000
RERANK_SERVICE_URL=http://rerank-service:8000
OCR_SERVICE_URL=
OCR_MODE=general
OCR_LANG=auto
OCR_TIMEOUT=60
OCR_SHARED_CONTAINER_DIR=/ocr-bridge
OCR_SHARED_HOST_DIR=
PDF_OCR_MAX_TEXT_CHARS_PER_PAGE=300
SQLITE_BUSY_TIMEOUT_SEC=30
#
# ==================== LLM 配置 ====================
LLM_PROVIDER=openai
LLM_MODEL=qwen2.5-7b-instruct
LLM_API_BASE=http://ollama:11434/v1
LLM_API_KEY=
LLM_CHAT_COMPLETIONS_URL=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.95
LLM_MAX_TOKENS=1200
LLM_MAX_OUTPUT_TOKENS_CAP=1600
LLM_CONTEXT_WINDOW=262144
LLM_OUTPUT_TOKEN_SAFETY_MARGIN=2048
ENABLE_FINAL_FACT_VERIFY=false
FINAL_FACT_VERIFY_MAX_TOKENS=0
REQUIRE_EVIDENCE=true
ENABLE_LLM_TIMING_LOG=true
LLM_MAX_TOKENS_DEF=700
LLM_MAX_TOKENS_SUMMARY=900
LLM_MAX_TOKENS_HOWTO=1000
LLM_MAX_TOKENS_COMPARE=1200
LLM_MAX_TOKENS_OTHER=900
LLM_MAX_TOKENS_ARCH=900
LLM_PRESENCE_PENALTY=1.5
LLM_EXTRA_BODY={"top_k":40,"chat_template_kwargs":{"enable_thinking":false}}
ENABLE_STRUCTURED_ANSWER_JSON=false

ENABLE_LLM_AS_JUDGE=true
ENABLE_EVAL_LLM_AS_JUDGE=true
EVAL_JUDGE_BACKEND=openai
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_TIMEOUT_SEC=60
DISABLE_STATIC_FAITHFULNESS=true
LEGAL_TRIAD_USE_LLM_JUDGE=true
LEGAL_TRIAD_DISABLE_STATIC_FAITHFULNESS=true

ENABLE_LLM_INTENT_CLASSIFIER=false
INTENT_CLASSIFIER_MAX_TOKENS=220
INTENT_CLASSIFIER_CACHE_SIZE=512
INTENT_CLASSIFIER_MIN_CONFIDENCE=0.62
ENABLE_LLM_TOOL_ROUTER=true
LLM_TOOL_ROUTER_MAX_TOKENS=120
LLM_TOOL_ROUTER_TIMEOUT=8
ENABLE_AGENTIC_ROUTER=true
AGENTIC_ROUTER_MAX_TOKENS=520
AGENTIC_ROUTER_TIMEOUT=8
AGENTIC_ROUTER_MIN_CONFIDENCE=0.55
ENABLE_LLM_EVIDENCE_CHECK=true
LLM_EVIDENCE_CHECK_MAX_CHARS=1800
LLM_EVIDENCE_CHECK_MAX_TOKENS=48
LLM_EVIDENCE_CHECK_TIMEOUT=4
LLM_EVIDENCE_CHECK_MIN_DENSE_REL=0.0
#
# ==================== 系统配置 ====================
CHUNK_SIZE=500
OVERLAP=100
TOP_K=50
RERANK_TOP_K=40
ENABLE_RERANK=true
MIN_RELEVANCE_SCORE=0.25
MIN_EVIDENCE_SCORE=0.6
EVIDENCE_GATE_RERANK_MIN_SCORE=0.6
MIN_SUBSTANTIVE_CHUNKS=1
MIN_RESCUE_SCORE=0.48
PRIMARY_EVIDENCE_TOPK=5
RESCUE_EVIDENCE_TOPK=15
ALLOW_GUARDED_FULL=true
RECALL_TOP_K=20
RECALL_RELATIVE_SCORE_RATIO=0.72
RECALL_MIN_KEEP_N=3
FINAL_CONTEXT_N=10
FINAL_CONTEXT_N_MAX=10
CONTEXT_MAX_CHARS=8000
CONTEXT_DOC_MAX_CHARS=1200
EVIDENCE_MAX_TOKENS=6500
HYBRID_STRUCT_W_SECTION_TERM=0.24
HYBRID_STRUCT_W_TEXT_TERM=0.18
HYBRID_STRUCT_W_SECTION_OVERLAP=0.22
HYBRID_STRUCT_W_KEYWORD=0.18
HYBRID_STRUCT_W_TITLE=0.10
HYBRID_STRUCT_W_BASE=0.08
HYBRID_STRUCT_FOLLOW_BONUS=0.16
HYBRID_STRUCT_FOLLOW_WINDOW=3
HYBRID_STRUCT_GENERIC_PENALTY=0.18
HYBRID_STRUCT_SECTION_MATCH_BONUS=0.22
HYBRID_STRUCT_SECTION_MISMATCH_PENALTY=0.12
#
# ==================== 安全配置 ====================
# ==================== RAG strategy / scoring thresholds ====================
FUSION_W_RERANK_DOC=0.3
RERANK_VERSION_FRESHNESS_REWARD=0.04
RERANK_ARTICLE_MATCH_REWARD=0.2
CLAUSE_RERANK_NON_EXACT_ARTICLE_PENALTY=0.25
CLAUSE_RERANK_HEADING_MATCH_BONUS=0.15
CLAUSE_RERANK_TOPIC_MATCH_BONUS=0.15
CLAUSE_RERANK_INTENT_MATCH_BONUS=0.18
CLAUSE_RERANK_INTENT_HEADING_BONUS=0.12
CLAUSE_RERANK_NEIGHBOR_ARTICLE_PENALTY=0.10
SOURCE_LOCK_TITLE_MATCH_BONUS=0.35
SOURCE_LOCK_REGION_MATCH_BONUS=0.25
SOURCE_LOCK_ANCHOR_MATCH_BONUS=0.30
SOURCE_LOCK_PRIOR_BONUS_CAP=0.15
SOURCE_LOCK_PRIOR_BONUS_WEIGHT=0.15
SOURCE_LOCK_MIN_ACCEPT_SCORE=0.55
ENABLE_SOURCE_LOCK_SOFT_DEGRADATION=true
SOURCE_LOCK_SOFT_DEGRADE_MIN_CONFIDENCE=0.90
SOURCE_WEAK_MATCH_UPGRADE_MIN_SCORE=0.70
SOURCE_DENSE_TITLE_EXTRA_MARGIN=0.05
AGENTIC_SUPPLEMENT_REGIONLESS_MIN_SCORE=8.0
AGENTIC_SUPPLEMENT_MIN_SCORE=0.75
AMBIGUOUS_SOFT_LOCK_SINGLE_RAW_TITLE_SCORE=6.2
AMBIGUOUS_SOFT_LOCK_MULTI_RAW_TITLE_SCORE=5.6
OPEN_TOPIC_HINT_RAW_TITLE_SCORE=8.4
HEADING_RESCUE_LEGAL_SECTION_BONUS=3.0
HEADING_RESCUE_LEGAL_BODY_BONUS=1.5
ASPECT_EVIDENCE_BODY_HIT_WEIGHT=1.45
ASPECT_EVIDENCE_INHERITED_HIT_WEIGHT=1.2
ASPECT_EVIDENCE_BODY_EXACT_WEIGHT=0.95
ASPECT_EVIDENCE_INHERITED_EXACT_WEIGHT=0.75
ASPECT_EVIDENCE_SECTION_HIT_WEIGHT=0.5
ASPECT_EVIDENCE_SECTION_EXACT_WEIGHT=0.25
ASPECT_EVIDENCE_GENERIC_SECTION_PENALTY=0.45
ASPECT_EVIDENCE_RANK_BONUS_BASE=0.25
ASPECT_EVIDENCE_RANK_BONUS_DECAY=0.01
ASPECT_EVIDENCE_CLAUSE_BONUS=0.35
ASPECT_EVIDENCE_SUBSTANTIVE_BONUS=0.25
ASPECT_RESCUE_SECTION_ALIGN_WEIGHT=0.6
ASPECT_RESCUE_SECTION_EXACT_WEIGHT=0.15
SUBJECT_FOCUS_TARGET_HIT_BONUS=0.06
SUBJECT_FOCUS_TARGET_BONUS_CAP=0.18
SUBJECT_FOCUS_EXCLUDED_HIT_PENALTY=0.18
SUBJECT_FOCUS_EXCLUDED_PENALTY_CAP=0.45
SUBJECT_FOCUS_UNMATCHED_EXCLUDED_PENALTY=0.12
ANSWER_STRUCTURED_ASPECT_MATCH_MIN_SCORE=35

ACCESS_CONTROL_ENABLED=true
PII_DETECTION_ENABLED=true
